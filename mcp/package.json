{
  "name": "sopet-admin-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for SOPET platform admin and store operations",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "bin": {
    "sopet-admin-mcp": "./src/stdio.ts"
  },
  "scripts": {
    "mcp:stdio": "tsx src/stdio.ts",
    "mcp:http": "tsx src/http.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "graphql": "^16.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
