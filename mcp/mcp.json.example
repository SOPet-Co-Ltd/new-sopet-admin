{
  "mcpServers": {
    "sopet-admin-local-stdio": {
      "command": "yarn",
      "args": ["--cwd", "/ABS/PATH/TO/sopet-admin/mcp", "mcp:stdio"],
      "env": {
        "SOPET_GRAPHQL_URL": "http://localhost:3002/graphql",
        "SOPET_ADMIN_EMAIL": "admin@sopet.org",
        "SOPET_ADMIN_PASSWORD": "replace-me"
      }
    },
    "sopet-admin-online": {
      "url": "https://api-new-uat.sopet.org/mcp",
      "headers": {
        "Authorization": "Bearer replace-with-MCP_HTTP_TOKEN"
      }
    }
  }
}
