# Local stdio / optional local HTTP only.
# Online MCP is served by sopet-backend at {API_URL}/mcp — no separate subdomain.

SOPET_GRAPHQL_URL=http://localhost:3002/graphql

SOPET_ADMIN_EMAIL=admin@sopet.org
SOPET_ADMIN_PASSWORD=

# Optional vendor session
SOPET_VENDOR_EMAIL=
SOPET_VENDOR_PASSWORD=
SOPET_VENDOR_STORE_ID=

# Optional local HTTP (127.0.0.1 only). Prefer backend /mcp for shared/online use.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3101
MCP_HTTP_TOKEN=
